[Unit]
Description=Fan PWM1 - always on 100% on boot
# Jalankan sebelum adas.service agar Orange Pi tidak overheat saat inferensi
Before=adas.service
After=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -ec '\
    pwm=/sys/class/pwm/pwmchip0/pwm1; \
    if [ ! -d "$pwm" ]; then \
        echo 1 > /sys/class/pwm/pwmchip0/export; \
    fi; \
    sleep 0.1; \
    echo 40000000 > "$pwm/period"; \
    echo 40000000 > "$pwm/duty_cycle"; \
    echo 1 > "$pwm/enable"'
ExecStop=/bin/sh -c '\
    echo 0 > /sys/class/pwm/pwmchip0/pwm1/duty_cycle || true; \
    echo 0 > /sys/class/pwm/pwmchip0/pwm1/enable      || true; \
    echo 1 > /sys/class/pwm/pwmchip0/unexport          || true'

[Install]
WantedBy=multi-user.target
