[Unit]
Description=Fan PWM1 - always on 100% on boot
# Jalankan sebelum adas.service agar Orange Pi tidak overheat saat inferensi
Before=adas.service
After=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '\
    echo 1 > /sys/class/pwm/pwmchip0/export || true; \
    sleep 0.1; \
    echo 0      > /sys/class/pwm/pwmchip0/pwm1/enable; \
    echo 40000000 > /sys/class/pwm/pwmchip0/pwm1/period; \
    echo 40000000 > /sys/class/pwm/pwmchip0/pwm1/duty_cycle; \
    echo 1      > /sys/class/pwm/pwmchip0/pwm1/enable'
ExecStop=/bin/sh -c '\
    echo 0 > /sys/class/pwm/pwmchip0/pwm1/duty_cycle || true; \
    echo 0 > /sys/class/pwm/pwmchip0/pwm1/enable      || true; \
    echo 2 > /sys/class/pwm/pwmchip0/unexport          || true'

[Install]
WantedBy=multi-user.target
